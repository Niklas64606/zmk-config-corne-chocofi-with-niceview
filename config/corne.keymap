#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        lt_z: layer_tap_z {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// | XXXX |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | XXXX |
// | XXXX |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | XXXX |
// | XXXX |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | XXXX |
//                    | GUI | SPC | LWR |   | ENT | BSPC | ALT |
            bindings = <
   &trans   &kp Q         &kp W         &kp E        &kp R        &kp T       &kp Y     &kp U          &kp I          &kp O        &kp P          &trans
   &trans   &hml LGUI A   &hml LALT S   &hml LCTRL D &hml LSHIFT F &kp G      &kp H     &hmr RSHIFT J  &hmr RCTRL K   &hmr RALT L  &hmr RGUI SEMI &trans
   &trans   &lt_z 3 Z     &kp X         &kp C        &kp V        &kp B       &kp N     &kp M          &kp COMMA      &kp DOT      &kp FSLH       &trans
                                        &kp LGUI     &kp SPACE    &mo 1       &kp LSHIFT &kp BSPC      &mo 2
            >;
        };

        lower_layer {
// -----------------------------------------------------------------------------------------
// | XXXX |BSPC |  2  |Enter|  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | XXXX |
// | XXXX |     |     | UP  |     |     |   | LFT | DWN |  UP | RGT |     | XXXX |
// | XXXX |     |Left | Down|Right|     |   |     |     |     |     |     | XXXX |
//                    | GUI |     | SPC |   | ENT |     | ALT |
            bindings = <
   &trans   &kp BSPC      &trans        &kp RET      &bt BT_CLR   &bt BT_CLR_ALL &trans   &kp N7  &kp N8 &kp N9  &kp N0   &trans
   &trans   &trans        &kp LC(LEFT)  &kp UP       &kp LC(RIGHT) &trans        &trans   &kp N4  &kp N5 &kp N6  &trans   &trans
   &trans   &kp HOME      &kp LEFT      &kp DOWN     &kp RIGHT    &kp END        &trans   &kp N1  &kp N2 &kp N3  &trans   &trans
                                        &kp LGUI     &trans       &kp SPACE      &kp RET  &kp N0  &kp RALT
            >;
        };

        raise_layer {
// -----------------------------------------------------------------------------------------
// | XXXX |     |     |     |     |     |   |  ?  |  &  |  *  |  (  |  )  | XXXX |
// | XXXX |     |     |     |     |     |   |  -  |  $  |  %  |  ^  |  \  | XXXX |
// | XXXX |     |     |     |     |     |   |  _  |  !  |  @  |  #  | "|" | XXXX |
//                    | GUI |     | SPC |   | ENT |     | ALT |
            bindings = <
   &trans   &trans   &trans   &trans   &trans   &trans    &kp QUESTION &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &trans
   &trans   &trans   &trans   &trans   &trans   &trans    &kp MINUS    &kp DLLR  &kp PRCNT       &kp CARET &kp BSLH &trans
   &trans   &trans   &trans   &trans   &trans   &trans    &kp UNDER    &kp EXCL  &kp AT          &kp HASH &kp PIPE &trans
                              &kp LGUI &trans   &kp SPACE &kp RET      &trans    &kp RALT
            >;
        };

        z_layer {     // Layer 3 
// -----------------------------------------------------------------------------------------
// | XXXX |  !  |  @  |  #  |  $  |  %  |   |  ?  |  &  |  *  |  (  |  )  | XXXX |
// | XXXX |     |     |     |     |     |   |  -  |  $  |  %  |  ^  |  \  | XXXX |
// | XXXX |     |     |     |     |     |   |  _  |  !  |  @  |  #  | "|" | XXXX |
//                    | GUI |     | SPC |   | ENT |     | ALT |
            bindings = <
   &trans   &kp L    &trans   &trans   &trans   &trans    &kp QUESTION &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &trans
   &trans   &trans   &trans   &trans   &trans   &trans    &kp MINUS    &kp DLLR  &kp PRCNT       &kp CARET &kp BSLH &trans
   &trans   &trans   &trans   &trans   &trans   &trans    &kp UNDER    &kp EXCL  &kp AT          &kp HASH &kp PIPE &trans
                              &kp LGUI &trans   &kp SPACE &kp RET      &trans    &kp RALT
            >;
        };
    }; 
};
