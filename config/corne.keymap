#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h> 

/ {
    // -------------------------------------------------------------------------
    // MACROS 
    // -------------------------------------------------------------------------
    macros {
        select_line: select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp HOME>,
                       <&macro_press &kp LSHIFT>,
                       <&macro_tap &kp END>,
                       <&macro_release &kp LSHIFT>;
        };
    };

    // -------------------------------------------------------------------------
    // BEHAVIORS
    // -------------------------------------------------------------------------
    behaviors {
        lt_z: layer_tap_z {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    // -------------------------------------------------------------------------
    // COMBOS
    // -------------------------------------------------------------------------
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };

        // U + I -> Double Quote (")
        combo_dqt {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp DQT>;
        };

        // J + L -> Colon (:)
        combo_colon {
            timeout-ms = <50>;
            key-positions = <19 21>;
            bindings = <&kp COLON>;
        };

        // J + Semicolon -> Semicolon (;)
        combo_semi {
            timeout-ms = <50>;
            key-positions = <19 22>;
            bindings = <&kp SEMI>;
        };

        // J + K -> Underscore (_)
        combo_underscore {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp UNDER>;
        };

        // H + J -> Minus (-)
        combo_minus {
            timeout-ms = <50>;
            key-positions = <18 19>;
            bindings = <&kp MINUS>;
        };

        // M + K -> Forward Slash (/)
        combo_fslh {
            timeout-ms = <50>;
            key-positions = <31 20>;
            bindings = <&kp FSLH>;
        };

        // D + V -> Backslash (\)
        combo_bslh {
            timeout-ms = <50>;
            key-positions = <15 28>;
            bindings = <&kp BSLH>;
        };

        combo_pipe {
            timeout-ms = <50>;
            key-positions = <13 25>;
            bindings = <&kp PIPE>;
        };

        // I + O + P -> Enter
        combo_enter {
            timeout-ms = <50>;
            key-positions = <8 9 10>;
            bindings = <&kp RET>;
        };

        // S + X -> Tilde (~)
        combo_tilde {
            timeout-ms = <50>;
            key-positions = <14 26>;
            bindings = <&kp TILDE>;
        };

        // A + E -> ä / Ä (Sends single quote, which Android's Swedish layout maps to ä)
        combo_se_a_umlaut {
            timeout-ms = <50>;
            key-positions = <13 3>;
            bindings = <&kp SQT>;
        };
        // A + Ö (SEMI) -> å / Å (Sends left bracket, which Android's Swedish layout maps to å)
        combo_se_a_ring {
            timeout-ms = <50>;
            key-positions = <13 22>;
            bindings = <&kp LBKT>;
        };
    };

    // -------------------------------------------------------------------------
    // KEYMAP
    // -------------------------------------------------------------------------
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// | XXXX |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | XXXX |
// | XXXX |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  Ö  | XXXX |
// | XXXX |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | XXXX |
//                    | GUI | SPC | LWR |   | ENT | BSPC | ALT |
            bindings = <
   &trans   &kp Q         &kp W         &kp E        &kp R        &kp T       &kp Y     &kp U          &kp I          &kp O        &kp P                  &trans
   &trans   &kp A   &hml LALT S   &hml LCTRL D &hml LSHIFT F &kp G       &kp H     &hmr RSHIFT J  &hmr RCTRL K   &hmr RALT L       &kp SEMI               &trans
   &trans   &lt_z 3 Z     &kp X         &kp C        &kp V        &kp B       &kp N     &kp M          &kp COMMA      &kp DOT      &kp SINGLE_QUOTE       &trans
                                        &kp LGUI     &kp SPACE    &mo 1       &kp LSHIFT &kp BSPC      &mo 2
            >;
        };

        lower_layer {
// -----------------------------------------------------------------------------------------
// | XXXX |BSPC |  2  |Enter|  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | XXXX |
// | XXXX |     |     | UP  |     |     |   | LFT | DWN |  UP | RGT |     | XXXX |
// | XXXX |     |Left | Down|Right|     |   |     |     |     |     |     | XXXX |
//                    | GUI |     | SPC |   | ENT |     | ALT |
            bindings = <
   &trans   &kp BSPC      &trans        &kp RET      &trans        &kp DEL                   &select_line   &kp N7  &kp N8 &kp N9  &kp N0   &trans
   &trans   &kp TAB   &kp LC(LEFT)      &kp UP       &kp LC(RIGHT) &msc MOVE_Y(10)           &trans         &kp N4  &kp N5 &kp N6  &trans   &trans
   &trans   &kp HOME      &kp LEFT      &kp DOWN     &kp RIGHT     &kp END                   &trans         &kp N1  &kp N2 &kp N3  &trans   &trans
                            &kp C_AC_BACK     &msc MOVE_Y(-10)     &kp SPACE                 &kp RET        &trans  &kp N0
            >;
        };

raise_layer {
// -----------------------------------------------------------------------------------------
// | XXXX |     |     |     |     |     |   |  ?  |  &  |  *  |  (  |  +  | XXXX |
// | XXXX |     |     |     |     |     |   |  -  |  $  |  %  |  ^  |  \  | XXXX |
// | XXXX |     |     |     |     |     |   |  _  |  !  |  @  |  #  |  +  | XXXX |
//                    | GUI |     | SPC |   | ENT |     | ALT |
            bindings = <
   &trans   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &trans      &trans            &kp LS(MINUS) &kp LS(N6) &kp LS(BSLH)  &kp LS(N8)  &kp MINUS     &trans
   &trans   &trans   &trans   &trans   &trans   &bt BT_CLR_ALL       &kp SLASH     &kp RA(N4) &kp LS(N5)    &kp RA(RBKT) &kp RA(MINUS) &trans
   &trans   &trans   &trans   &trans   &trans   &bt BT_CLR           &kp LS(SLASH) &kp LS(N1) &kp RA(N2)    &kp LS(N3)   &kp MINUS     &trans
                              &kp LGUI &trans   &kp SPACE            &kp RET       &trans     &kp RALT
            >;
        };

        z_layer {     // Layer 3 
// -----------------------------------------------------------------------------------------
// | XXXX |  !  |  @  |  #  |  $  |  %  |   |  ?  |  &  |  *  |  (  |  )  | XXXX |
// | XXXX |     |     |     |     |     |   |  -  |  $  |  %  |  ^  |  \  | XXXX |
// | XXXX |     |     |     |     |     |   |  _  |  !  |  @  |  #  | "|" | XXXX |
//                    | GUI |     | SPC |   | ENT |     | ALT |
            bindings = <
   &trans      &trans      &trans      &trans     &trans    &kp LC(T)          &kp QUESTION &kp AMPS  &kp KP_MULTIPLY &kp LPAR   &kp RPAR         &trans
   &trans      &kp LC(A)   &kp LC(S)   &trans     &kp LC(F) &kp C_AC_SEARCH    &kp MINUS    &kp DLLR  &kp PRCNT       &kp CARET  &kp BSLH         &trans
   &trans      &trans      &kp LC(X)   &kp LC(C)  &kp LC(V) &trans             &kp UNDER    &kp EXCL  &kp AT          &kp HASH   &kp PIPE         &trans
                              &kp LGUI &trans   &kp SPACE &kp RET              &trans    &kp RALT
            >;
        };
    }; 
};
